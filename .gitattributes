# Signed test files and keys must keep their exact bytes on every platform.
# Without this, Git on Windows can check them out with CRLF line ends, and
# the signature checks fail.
crates/consort-tools/tests/fixtures/** -text
crates/consort-tools/keys/** -text

# Text that the hub program embeds with include_str!. A test and the prompt
# code search for "\n", so Git on Windows must not make it CRLF.
crates/consort-hub/prompts/** text eol=lf
crates/consort-hub/src/store/*.sql text eol=lf

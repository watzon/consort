{
  "$comment": "Maps Consort color roles to GPUI Kit 0.8.1 theme keys. Expressions: a role path such as surface.canvas; hover(x) and active(x) move OKLCH lightness by derive.hover_delta_l and derive.active_delta_l (up in dark mode, down in light mode); alpha(x, a); tint(x) is alpha(x, derive.status_tint_alpha); on(x) is whichever of surface.sidebar and text.primary has the higher contrast on x; transparent. scrim is alpha(#000000, derive.scrim_alpha) for the mode.",
  "colors": {
    "background": "surface.canvas",
    "foreground": "text.primary",
    "border": "border.subtle",
    "input.border": "border.strong",
    "ring": "accent.text",
    "caret": "accent.text",
    "selection.background": "alpha(accent.fill, 0.28)",
    "overlay": "scrim",
    "window.border": "border.subtle",
    "primary.background": "accent.fill",
    "primary.foreground": "accent.on_fill",
    "primary.hover.background": "hover(accent.fill)",
    "primary.active.background": "active(accent.fill)",
    "secondary.background": "surface.raised",
    "secondary.foreground": "text.primary",
    "secondary.hover.background": "hover(surface.raised)",
    "secondary.active.background": "active(surface.raised)",
    "accent.background": "surface.selected",
    "accent.foreground": "text.primary",
    "muted.background": "surface.card",
    "muted.foreground": "text.secondary",
    "danger.background": "status.failed",
    "danger.foreground": "on(status.failed)",
    "success.background": "status.done",
    "success.foreground": "on(status.done)",
    "info.background": "status.working",
    "info.foreground": "on(status.working)",
    "warning.background": "accent.fill",
    "warning.foreground": "accent.on_fill",
    "link.foreground": "text.primary",
    "link.hover.foreground": "accent.text",
    "link.active.foreground": "accent.text",
    "popover.background": "surface.raised",
    "popover.foreground": "text.primary",
    "group_box.background": "surface.card",
    "group_box.foreground": "text.primary",
    "accordion.background": "surface.card",
    "description_list_label.foreground": "text.secondary",
    "skeleton.background": "surface.card",
    "drag_border": "accent.text",
    "drop_target.background": "alpha(accent.fill, 0.12)",
    "list.background": "surface.canvas",
    "list.even.background": "surface.canvas",
    "list.head.background": "surface.sidebar",
    "list.hover.background": "hover(surface.canvas)",
    "list.active.background": "surface.selected",
    "list.active.border": "border.strong",
    "table.background": "surface.canvas",
    "table.even.background": "surface.canvas",
    "table.head.background": "surface.sidebar",
    "table.head.foreground": "text.secondary",
    "table.hover.background": "hover(surface.canvas)",
    "table.active.background": "surface.selected",
    "table.active.border": "border.strong",
    "table.row.border": "border.subtle",
    "sidebar.background": "surface.sidebar",
    "sidebar.foreground": "text.secondary",
    "sidebar.border": "border.subtle",
    "sidebar.accent.background": "surface.selected",
    "sidebar.accent.foreground": "text.primary",
    "sidebar.primary.background": "accent.fill",
    "sidebar.primary.foreground": "accent.on_fill",
    "tab_bar.background": "surface.sidebar",
    "tab_bar.segmented.background": "surface.card",
    "tab.background": "transparent",
    "tab.foreground": "text.secondary",
    "tab.active.background": "surface.canvas",
    "tab.active.foreground": "text.primary",
    "title_bar.background": "surface.sidebar",
    "title_bar.border": "border.subtle",
    "status_bar.background": "surface.sidebar",
    "status_bar.border": "border.subtle",
    "scrollbar.background": "transparent",
    "scrollbar.thumb.background": "alpha(text.tertiary, 0.35)",
    "scrollbar.thumb.hover.background": "alpha(text.tertiary, 0.6)",

    "editor.active_line_number": "text.secondary",
    "editor.invisible": "border.strong",
    "created": "status.done",
    "modified": "status.working",
    "conflict": "status.failed",
    "warning": "accent.text",
    "hint": "text.tertiary",
    "hidden": "text.tertiary",
    "predictive": "text.tertiary",
    "syntax": {
      "keyword": "syntax.keyword",
      "string": "syntax.string",
      "string.escape": "syntax.number",
      "string.regex": "syntax.string",
      "string.special": "syntax.string",
      "string.special.symbol": "syntax.type",
      "number": "syntax.number",
      "boolean": "syntax.number",
      "constant": "syntax.number",
      "function": "syntax.function",
      "constructor": "syntax.type",
      "type": "syntax.type",
      "tag": "syntax.tag",
      "attribute": "syntax.attribute",
      "property": "text.secondary",
      "variable": "text.primary",
      "variable.special": "syntax.keyword",
      "comment": "text.tertiary",
      "comment.doc": "text.tertiary",
      "embedded": "text.primary",
      "emphasis": "text.primary",
      "emphasis.strong": "text.primary",
      "link_text": "text.primary",
      "link_uri": "text.secondary",
      "text.literal": "syntax.string",
      "text.code.span": "text.primary",
      "title": "text.primary"
    }
  },
  "fixed": {
    "font_family": "font.sans",
    "mono_font_family": "font.mono",
    "font_size": "type.ui.size",
    "mono_font_size": "type.mono.size",
    "radius": "radius.md",
    "radius_lg": "radius.lg",
    "shadow": true,
    "tokens.radius": {
      "none": 0,
      "sm": "radius.sm",
      "md": "radius.md",
      "lg": "radius.lg",
      "xl": "radius.xl",
      "full": "radius.full"
    },
    "tokens.spacing": {
      "xxs": "space.xxs",
      "xs": "space.xs",
      "sm": "space.sm",
      "md": "space.md",
      "lg": "space.lg",
      "xl": "space.xl",
      "xxl": "space.xxl"
    },
    "tokens.shadow": {
      "sm": "shadow.none",
      "md": "shadow.float",
      "lg": "shadow.float"
    }
  }

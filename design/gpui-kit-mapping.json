    "slider.bar.background": "accent.text",
    "slider.thumb.background": "text.primary",
    "switch.background": "accent.text",
    "chart.1": "status.working",
    "chart.2": "status.done",
    "chart.3": "status.scheduled",
    "chart.4": "accent.fill",
    "chart.5": "status.failed",
    "chart.bullish": "status.done",
    "chart.bearish": "status.failed",
    "chart.grid": "border.subtle",
    "base.red": "status.failed",
    "base.red.light": "tint(status.failed)",
    "base.green": "status.done",
    "base.green.light": "tint(status.done)",
    "base.blue": "status.working",
    "base.blue.light": "tint(status.working)",
    "base.yellow": "accent.fill",
    "base.yellow.light": "tint(accent.fill)",
    "base.magenta": "status.scheduled",
    "base.magenta.light": "tint(status.scheduled)",
    "base.cyan": "syntax.type",
    "base.cyan.light": "tint(syntax.type)"
